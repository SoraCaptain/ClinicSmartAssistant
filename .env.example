# Root env — dev (Makefile targets) and docker compose both read it.
# Compose additionally passes OPENAI_*, LLM_MODEL, DEFAULT_PATIENT_ID and
# LANGFUSE_* through to the ai container; service URLs are compose-internal
# and set in docker-compose.yml. LLM_MODEL must be a NON-thinking model if a
# thinking provider is used (structured-output tool_choice constraint).

# --- backend ---
DATABASE_URL=postgresql+psycopg://clinicpilot:clinicpilot@localhost:5432/clinicpilot
AI_SERVICE_URL=http://localhost:8001

# --- ai-service ---
BACKEND_URL=http://localhost:8000
DEFAULT_PATIENT_ID=P001
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# --- langfuse (optional; absent keys → tracing off, P6) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
